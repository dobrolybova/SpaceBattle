{
    "openapi": "3.1.1",
    "info": {
        "title": "Space battle API: Notification part.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/api/v1/notification"
        }
    ],
    "paths": {
        "/subscribe": {
            "post": {
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Subscribe"
                            }
                        }
                    },
                    "required": false
                },
                "responses": {
                    "200": {
                        "description": "User subscribes on list of events."
                    },
                    "403": {
                        "description": "User not authorised."
                    },
                    "400": {
                        "description": "Event not exists."
                    }
                },
                "deprecated": false
            }
        },
        "/ws": {}
    },
    "components": {
        "schemas": {
            "Event": {
                "type": "string",
                "enum": [
                    "TOURNAMENT_STARTED",
                    "TOURNAMENT_ANNOUNCED",
                    "BATTLE_IS_STARTED",
                    "BATTLE_IS_STARTED_SOON",
                    "BATTLE_IS_FINISHED"
                ],
                "title": "Event"
            },
            "Subscribe": {
                "properties": {
                    "user_id": {
                        "type": "integer",
                        "title": "User Id"
                    },
                    "events": {
                        "items": {
                            "$ref": "#/components/schemas/Event"
                        },
                        "type": "array",
                        "title": "Events"
                    }
                },
                "type": "object",
                "required": [
                    "user_id",
                    "events"
                ],
                "title": "Subscribe"
            }
        }
    }
}